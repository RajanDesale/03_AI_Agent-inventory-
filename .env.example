# ---------- Shop ----------
SHOP_NAME=Rajan Electronics

# ---------- LLM (run `ollama list` and copy the exact name) ----------
OLLAMA_MODEL=qwen2.5:7b

# ---------- Database ----------
# SQLite = zero setup (default)
DATABASE_URL=sqlite:///shop.db
# MySQL example:
# DATABASE_URL=mysql+pymysql://USER:PASSWORD@localhost:3306/electro_shop

# ---------- Stock alert rules ----------
LOW_STOCK_DEFAULT=5
# true = owner gets a message after EVERY sale with remaining stock
# false = owner gets a message only when stock is at/below the threshold
ALERT_ON_EVERY_SALE=true

# ---------- Owner alert: Telegram (FREE) ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------- Optional SMS via Fast2SMS (PAID, India) ----------
FAST2SMS_API_KEY=
OWNER_PHONE=
OWNER_SMS=false
CUSTOMER_SMS=false
